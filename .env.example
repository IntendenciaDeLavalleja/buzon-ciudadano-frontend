# -------------------------------------------------------
# Variables públicas del Frontend (Vite)
# Los nombres VITE_* son expuestos al cliente (browser).
# -------------------------------------------------------

# URL base del backend Flask.
# Ejemplo producción: https://api.buzon.ejemplo.uy
# Ejemplo local:      http://localhost:5000
#
# En Coolify, configurar como Build Arg antes de cada despliegue.
# En Docker manual: --build-arg VITE_API_URL=https://...
VITE_API_URL=http://localhost:5000

# Número de WhatsApp para consultas (con código de país, sin el +).
# Ejemplo Uruguay: 59898018085
VITE_WHATSAPP_NUMBER=59898018085
